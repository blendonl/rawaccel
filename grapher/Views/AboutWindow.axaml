<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:grapher.ViewModels"
        x:Class="grapher.Views.AboutWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="About Raw Accel"
        Icon="/Assets/mouse.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource RaBackgroundBrush}"
        Foreground="{DynamicResource RaForegroundBrush}">
  <StackPanel Margin="24" Spacing="8" MinWidth="320">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Source="/Assets/mouse.ico" Width="40" Height="40" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="section" Text="Raw Accel" FontSize="20" />
        <TextBlock Classes="hint" Text="Mouse acceleration driver for Windows" />
      </StackPanel>
    </StackPanel>
    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
      <TextBlock Text="GUI version" />
      <TextBlock Grid.Column="2" x:Name="GuiVersion" />
      <TextBlock Grid.Row="1" Text="Driver version" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DriverVersion}" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Content="Project page" Click="OnProjectClick" />
      <Button Content="Guide" Click="OnGuideClick" />
      <Button Classes="accent" Content="Close" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    </StackPanel>
  </StackPanel>
</Window>
