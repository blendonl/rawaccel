<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:grapher.ViewModels"
             x:Class="grapher.Views.ChartsView"
             x:DataType="vm:MainWindowViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <WrapPanel Orientation="Horizontal">
        <CheckBox Margin="0,0,20,0" Content="Velocity and gain" IsChecked="{Binding ShowVelocityAndGain}"
                  ToolTip.Tip="Also chart output speed and gain (the slope of the velocity chart)." />
        <CheckBox Margin="0,0,20,0" Content="Last mouse move" IsChecked="{Binding ShowLastMouseMove}"
                  ToolTip.Tip="Mark your latest mouse movement on the charts." />
        <StackPanel Margin="0,0,20,0" Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="Your mouse's DPI. Sets the range of input speeds shown on the charts. Does not change your sensitivity. Follows the profile's Mouse DPI when it's set.">
          <TextBlock Text="Chart DPI" VerticalAlignment="Center" />
          <TextBox Width="76" Text="{Binding ChartDpiText}" Classes.error="{Binding ChartDpiHasError}" />
        </StackPanel>
        <StackPanel Margin="0,0,20,0" Orientation="Horizontal" Spacing="6"
                    ToolTip.Tip="Your mouse's polling rate in Hz. Keeps the last-mouse-move marker accurate. Follows the profile's polling rate when it's set.">
          <TextBlock Text="Poll rate" VerticalAlignment="Center" />
          <TextBox Width="76" Text="{Binding ChartPollRateText}" Classes.error="{Binding ChartPollRateHasError}" />
        </StackPanel>
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding LastMoveText}"
                   ToolTip.Tip="Raw counts of your last mouse movement. (n) means the device's DPI is normalized in the device settings." />
      </WrapPanel>
    </Border>
    <Grid x:Name="ChartGrid" Margin="8" />
  </DockPanel>
</UserControl>
