<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:grapher.ViewModels"
        x:Class="grapher.Views.DeviceMenuWindow"
        x:DataType="vm:DeviceMenuViewModel"
        Title="Devices"
        Icon="/Assets/mouse.ico"
        Width="680" Height="440" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource RaBackgroundBrush}"
        Foreground="{DynamicResource RaForegroundBrush}">
  <DockPanel Margin="16">
    <CheckBox DockPanel.Dock="Top" Margin="0,0,0,12" Content="Disable by default"
              IsChecked="{Binding DefaultDisabled}"
              ToolTip.Tip="Raw Accel ignores devices without their own settings." />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" MinWidth="96" IsCancel="True" Click="OnCancel" />
      <Button Classes="accent" Content="Apply" MinWidth="96" IsDefault="True" Click="OnApply"
              ToolTip.Tip="Save device settings and apply them together with the profile you're editing." />
    </StackPanel>

    <Grid ColumnDefinitions="240,16,*">
      <Border Classes="card" Padding="0">
        <Panel>
          <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceItemViewModel">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="hint" Text="{Binding ListHint}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="hint" Margin="12" Text="No mice detected." IsVisible="{Binding !HasDevices}" />
        </Panel>
      </Border>

      <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="10" DataContext="{Binding Selected}" x:DataType="vm:DeviceItemViewModel">
          <TextBlock Classes="section" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
          <SelectableTextBlock Classes="hint" Text="{Binding Id}" ToolTip.Tip="Device ID" TextWrapping="Wrap" />
          <CheckBox Content="Use custom settings for this device" IsChecked="{Binding OverrideDefaults}" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" IsEnabled="{Binding CanEdit}">
            <TextBlock Classes="label" Text="Disable" />
            <CheckBox Grid.Column="1" IsChecked="{Binding Disable}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Profile" Margin="0,8,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      ToolTip.Tip="The profile this mouse uses. Default follows whichever profile is set as the default.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileOption">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Classes="hint" Text="{Binding ProfileSummary}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
