<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:grapher.ViewModels"
        xmlns:s="using:grapher.Settings"
        x:Class="grapher.Views.ProfileDialogWindow"
        x:DataType="vm:ProfileDialogViewModel"
        Title="{Binding Title}"
        Icon="/Assets/mouse.ico"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource RaBackgroundBrush}"
        Foreground="{DynamicResource RaForegroundBrush}">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <TextBox x:Name="NameBox" Text="{Binding Name}" IsVisible="{Binding AsksForName}"
             MaxLength="{x:Static s:DriverSession.MaxProfileNameLength}"
             Classes.error="{Binding HasNameError}" />
    <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource RaErrorBrush}"
               TextWrapping="Wrap" IsVisible="{Binding HasNameError}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Cancel" MinWidth="96" IsCancel="True" Click="OnCancel" />
      <Button Classes="accent" Content="{Binding ConfirmText}" MinWidth="96" IsDefault="True"
              IsEnabled="{Binding CanConfirm}" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
