<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>writer</RootNamespace>
    <AssemblyName>writer</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wrapper\wrapper.vcxproj" />
  </ItemGroup>

  <Target Name="CopyToSigned" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <SignedFiles Include="$(OutDir)**\*" Exclude="$(OutDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(SignedFiles)" DestinationFiles="@(SignedFiles->'$(MSBuildThisFileDirectory)..\signed\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
